# Strict privacy default: discard all application logs, including access logs.
# Docker logging is separately disabled; no console/file handlers.
version: 1
disable_existing_loggers: true
handlers:
  discard:
    class: logging.NullHandler
loggers:
  synapse.access:
    handlers: [discard]
    propagate: false
  synapse:
    handlers: [discard]
    propagate: false
  twisted:
    handlers: [discard]
    propagate: false
root:
  handlers: [discard]
  level: CRITICAL
